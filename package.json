        "knex",
        "mysql2",
        "postgres",
        "sql.js",
        "sqlite3",
        "@prisma/client",
        "@tidbcloud/serverless",
        "@planetscale/database",
        "@electric-sql/pglite",
        "@cloudflare/workers-types",
        "@aws-sdk/client-rds-data",
        "@xata.io/client",
        "@types/sql.js",
        "@types/better-sqlite3"
      ],
      "allowedVersions": {
        "react-native>react": "*"
      },
      "allowedDeprecatedVersions": {
        "@vercel/postgres": "*",
        "@esbuild-kit/core-utils": "*",
        "@esbuild-kit/esm-loader": "*",
        "@npmcli/move-file": "*",
        "are-we-there-yet": "*",
        "gauge": "*",
        "glob": "*",
        "inflight": "*",
        "node-domexception": "*",
        "npmlog": "*",
        "rimraf": "*",
        "tar": "*"
      }
    }
  },
