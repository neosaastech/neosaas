  "scripts": {
    "build": "bash scripts/build-with-db.sh",
    "build:local": "next build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:ensure": "tsx scripts/db-ensure-columns.ts",
    "db:verify": "tsx scripts/db-verify-schema.ts",
    "db:reset": "tsx scripts/reset-db.ts",
    "db:hard-reset": "tsx scripts/reset-db.ts && pnpm db:migrate && tsx scripts/seed-database.ts",
    "db:seed": "tsx scripts/seed-database.ts",
    "db:seed-base": "tsx scripts/seed-base-data.ts",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev",
    "lint": "eslint .",
    "lint:layers": "tsx scripts/lint-layers.ts",
    "start": "next start",
    "seed:email-templates": "tsx scripts/seed-email-templates.ts",
    "seed:pages": "tsx scripts/sync-pages.ts",
    "seed:page-layers": "tsx scripts/seed-page-layers.ts",
    "db:local:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:local:down": "docker compose -f docker-compose.dev.yml down",
    "db:local:setup": "bash scripts/dev-db-setup.sh",
    "seed:dev-admin": "tsx scripts/seed-dev-admin.ts",
    "ensure:bootstrap-admin": "tsx scripts/ensure-bootstrap-super-admin.ts",
    "check:email-config": "tsx scripts/check-email-config.ts",
    "test:mcp": "tsx scripts/test-mcp.ts",
    "test:content-hub-page": "tsx scripts/test-content-hub-page.ts",
    "test:content-hub-article": "tsx scripts/test-content-hub-article.ts"
  },
  "pnpm": {
    "overrides": {
      "react-native": "npm:empty-npm-package@1.0.0",
      "@vercel/postgres": "npm:empty-npm-package@1.0.0"
    },
    "peerDependencyRules": {
      "ignoreMissing": [
        "react-native",
        "@op-engineering/op-sqlite",
        "@libsql/client",
        "@libsql/client-wasm",
        "expo-sqlite",
        "gel",
        "better-sqlite3",
        "bun-types",
