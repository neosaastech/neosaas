# ── Fichiers systèmes ─────────────────────────────────────────────────────────
.bash_history
.bash_logout
.bashrc
.profile
.gitconfig
.sudo_as_admin_successful
.cloud-locale-test.skip
.DS_Store
Thumbs.db
*.log
*.tmp
*.swp
*.swo
*~

