# ── Secrets & credentials (CRITIQUE — ne jamais committer) ───────────────────
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
token.json
token_oneline.json
.railway/
.terraform.d/
.aws/
.azure/

# Kubeconfigs avec tokens
.kube/kapsule-*.yaml
.kube/config

# Scaleway / rclone configs
.config/scw/
.config/rclone/

# ── Données volumineuses ──────────────────────────────────────────────────────
SharePoint/
OneDrive/
onedrive/
Bureau/
Documents/
Images/
Games/
backups/
kubinote-backups/
ollama-models/
seo_outputs/
scan_report.json
sync_report.md

# ── Caches et runtimes ───────────────────────────────────────────────────────
.cache/
.local/
__pycache__/
scripts/__pycache__/
*.pyc
*.pyo
.venv/
venv/
node_modules/

# ── Outils tiers / config perso ──────────────────────────────────────────────
.claude/
.claude.json
.claude.json.bak
.ZAP/
.agents/
.aitk/
.gitkraken/
.gnupg/
.ssh/
.pki/
