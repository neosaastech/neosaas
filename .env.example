# ============================================================================
# NeoSaaS - Free Version - Environment Variables Template
# ============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env file to git!


DATABASE_URL=postgresql:

DATABASE_URL_UNPOOLED=
# ============================================================================
# AUTHENTICATION
# ============================================================================
# Secret key for JWT tokens (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=your-secret-key-at-least-32-characters-long

# ============================================================================
# APPLICATION
# ============================================================================
# Public URL of your application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================================
# LOCAL POSTGRES FOR PUCK BUILDER (optional — branche feat/puck-builder-local)
# ============================================================================
# docker compose -f docker-compose.dev.yml up -d   # ou: pnpm db:local:setup
# DATABASE_URL=postgresql://neosaas:neosaas@localhost:5433/neosaas_dev
# DATABASE_URL_UNPOOLED=postgresql://neosaas:neosaas@localhost:5433/neosaas_dev
# NEOSAAS_OFFLINE_DEV=false
# Login après pnpm db:local:setup : admin@exemple.com / admin
# Builder : http://localhost:3000/admin/pilotage/builder

# ============================================================================
# LOCAL DEV WITHOUT DATABASE (optional)
# ============================================================================
# Set to true to run without Postgres/Neon: auto-login as super_admin,
# mock products on /pricing, homepage blocks from code (no DB seed needed).
# Auto-detected when DATABASE_URL contains "placeholder".
# NEOSAAS_OFFLINE_DEV=true

# ============================================================================
# STRIPE (Optional — managed via Admin > API Management)
# These are fallback env vars; prefer using the Admin UI to store keys.
# ============================================================================
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ============================================================================
# EMAIL PROVIDER (Choose one or configure multiple)
# ============================================================================

# RESEND (Recommended for simplicity)
RESEND_API_KEY=re_xxxxxxxxxxxx

# OR SCALEWAY TEM
SCALEWAY_TEM_PROJECT_ID=your-project-id
SCALEWAY_TEM_SECRET_KEY=your-secret-key
SCALEWAY_TEM_API_URL=https://api.tem.scaleway.com

# OR AWS SES
AWS_REGION=eu-west-1
AWS_SES_ACCESS_KEY_ID=your-access-key
AWS_SES_SECRET_ACCESS_KEY=your-secret-key

# ============================================================================
# OBJECT STORAGE (Optional — Scaleway Object Storage, S3-compatible)
# Falls back to base64-in-Postgres for product images if unset.
# ============================================================================
# SCW_ACCESS_KEY=SCWxxxxxxxxxxxxxxxxx
# SCW_SECRET_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# SCW_BUCKET_NAME=your-bucket-name
# SCW_BUCKET_ENDPOINT=https://your-bucket-name.s3.fr-par.scw.cloud
# SCW_REGION=fr-par

# ============================================================================
# OPTIONAL FEATURES
# ============================================================================

# Contact form destination email (for support requests)
CONTACT_EMAIL=support@yourdomain.com

# Admin notification email
ADMIN_EMAIL=admin@yourdomain.com

# ============================================================================
# SYSTEM UPDATES (Admin → Parameters → Mises à jour)
# ============================================================================
# Current build version, compared against the Core repo's latest tag.
# Set at build/deploy time (e.g. from your image tag or package.json version).
NEXT_PUBLIC_APP_VERSION=1.0.1

# Core repo to check for updates against, "owner/repo" — private repo, needs GITHUB_TOKEN below.
CORE_GITHUB_REPO=neosaastech/Neosaas-app

# GitHub PAT with read access to CORE_GITHUB_REPO (fine-grained, contents:read is enough).
GITHUB_TOKEN=ghp_your_token_here

# Kube-side webhook that triggers the rollout restart for this namespace.
# NOT YET BUILT — this is only the Next.js-side caller. The receiver needs its
# own auth, scoped RBAC (this one deployment only), and rate limiting; that's
# cluster-side infra work, not something this app can safely do on its own.
# "Apply patch" returns a clear 501 until this is configured.
UPDATE_ORCHESTRATOR_WEBHOOK_URL=https://update-orchestrator.internal.example.com/rollout
UPDATE_SYSTEM_TOKEN=replace-with-a-long-random-shared-secret
